<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>Launcher</AssemblyName>
    <AssemblyTitle>Pinkie's System Monitor Launcher</AssemblyTitle>
    <Description>Portable launcher and shared product information dialog</Description>
    <ApplicationIcon>..\PinkieSysMon\PinkieSysMon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Source-share the canonical writer/retention policy without a Runtime dependency. -->
    <Compile Include="..\PinkieSysMon\LogFileWriter.cs" Link="LogFileWriter.cs" />
    <!-- Portable Settings uses source-shared BCL/WinForms contracts, never Runtime.dll. -->
    <Compile Include="..\PinkieSysMon\FilesystemSourceModel.cs" Link="FilesystemSourceModel.cs" />
    <Compile Include="..\PinkieSysMon\FilesystemScanner.cs" Link="FilesystemScanner.cs" />
    <Compile Include="..\PinkieSysMon.Editor\EditorSettings.cs" Link="EditorSettings.cs" />
    <Compile Include="..\PinkieSysMon.Editor\StartupTaskManager.cs" Link="StartupTaskManager.cs" />
    <Compile Include="..\PinkieSysMon.Editor\EditorSessionWire.cs" Link="EditorSessionWire.cs" />
    <Compile Include="..\PinkieSysMon.Editor\EditorTheme.cs" Link="EditorTheme.cs" />
    <Compile Include="..\PinkieSysMon.Editor\PinkieEditorForm.cs" Link="PinkieEditorForm.cs" />
    <Compile Include="..\PinkieSysMon.Editor\FilesystemSourcesDialog.cs" Link="FilesystemSourcesDialog.cs" />
    <Compile Include="..\PinkieSysMon.Editor\FilesystemEnableWarningDialog.cs" Link="FilesystemEnableWarningDialog.cs" />
  </ItemGroup>
</Project>
