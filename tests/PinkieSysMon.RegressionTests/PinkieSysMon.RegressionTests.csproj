<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PinkieSysMon.RegressionTests</AssemblyName>
    <RootNamespace>PinkieSysMon.RegressionTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PinkieSysMon">
      <HintPath>$(PinkiePublishPath)\PinkieSysMon.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PinkieSysMon.Editor">
      <HintPath>$(PinkiePublishPath)\PinkieSysMon.Editor.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.152.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>
</Project>
